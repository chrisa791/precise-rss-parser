<?xml version="1.0"?>
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:m="http://search.yahoo.com/mrss/">
  <channel>
    <title>Media Feed</title>
    <link>https://example.com</link>
    <description>Feed with namespaced extensions.</description>
    <item>
      <title>Clip</title>
      <content:encoded><![CDATA[<p>Full <b>body</b></p>]]></content:encoded>
      <m:content url="https://example.com/clip.mp4" type="video/mp4" medium="video" width="640" height="360"/>
      <m:thumbnail url="https://example.com/clip.jpg" width="120" height="90"/>
    </item>
    <item>
      <title>Grouped</title>
      <m:group>
        <m:content url="https://example.com/a.mp4"/>
        <m:content url="https://example.com/b.mp4" type="video/mp4"/>
      </m:group>
    </item>
  </channel>
</rss>
